# This machine's home-network address, the one the Plex server is on. Never 0.0.0.0 on a machine that faces the
# internet.
ATHENA_BIND=192.168.1.10
# Keep 8800 for Ithaca to find Athena on its own.
ATHENA_PORT=8800
# Your Plex server as Athena reaches it. Only people with access to it can use Athena.
PLEX_URL=http://192.168.1.10:32400
# A key from its own Claude Console workspace with a monthly spend limit.
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5.
ATHENA_MODEL=
# Optional: TypeSafe's key for Jev, library picks in a quarter of a second instead of about eight.
TYPESAFE_API_KEY=
