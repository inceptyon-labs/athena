# This machine's home-network address, the one the Plex server is on. Never 0.0.0.0 on a machine that faces the
# internet.
ATHENA_BIND=192.168.1.10
# Keep 8800 for Ithaca to find Athena on its own.
ATHENA_PORT=8800
# Settings and Automations, home network only.
ATHENA_ADMIN_PORT=8801
# The time zone that "today" and "this month" follow on the status page.
TZ=America/New_York

# Everything below is optional: open http://<ATHENA_BIND>:8801/ and set it up in the browser instead.
# A value set here wins over the browser, which then shows it locked. Each key can be read from a file instead, by the
# same name with _FILE added (ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic), for Docker secrets or a vault's agent.
# PLEX_URL=http://192.168.1.10:32400
# ATHENA_PROVIDER=anthropic          # or openai, gemini, xai, deepseek, local
# ATHENA_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# TYPESAFE_API_KEY=
# ABS_URL=http://192.168.1.10:13378   # Audiobookshelf, for automations
# ABS_API_KEY=
