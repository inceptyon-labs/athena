# The LAN address to publish on. Never 0.0.0.0.
MENTOR_BIND=192.168.2.222
MENTOR_PORT=8800
# A key from its own Claude Console workspace with a monthly spend limit.
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5.
MENTOR_MODEL=
# TypeSafe's key for Jev: library picks in a quarter of a second instead of
# about eight. Without it, Claude makes them.
TYPESAFE_API_KEY=
